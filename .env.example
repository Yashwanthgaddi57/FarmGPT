# ---- Frontend (Next.js) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Backend (FastAPI) ----
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
PROJECT_NAME=AgriSphere AI

# Supabase (service role: backend only)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_DB_URL=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Local dev only (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agrisphere
DATABASE_URL_LOCAL=postgresql+psycopg://postgres:postgres@db:5432/agrisphere
REDIS_URL=redis://redis:6379/0

# AI
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.2

# Market data (real Agmarknet mandi prices via data.gov.in; get a free key at
# https://data.gov.in/user/register -> "API Key". Empty = synthetic baseline fallback)
DATA_GOV_API_KEY=

# Weather (Open-Meteo is free & keyless; optional providers)
OPENWEATHER_API_KEY=

# Notifications (optional email via Resend)
RESEND_API_KEY=

# Background scheduler
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=30
